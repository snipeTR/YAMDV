# 018a §2-D: integrations and bug regressions (encoding reopen, editor detection, BUG-01/02, CF_HTML).
command mode light
wait-idle
# Encoding: a windows-1254 file that chardetng detects as windows-1252 reopens as 1254, reads
# correctly, and saves byte-exact.
ui copy-file ../fixtures/tr-1254.md ib-1254.tmp.md
ui bytes-mark ../fixtures/tr-1254.md
open ib-1254.tmp.md
wait-idle
assert doc_encoding == windows-1252
assert file_same == 1
command reopen-encoding windows-1254
wait-idle
assert doc_encoding == windows-1254
assert preview contains Şu an
key f3
wait-idle
key ctrl+end
type x
key ctrl+s
wait-idle
key backspace
key ctrl+s
wait-idle
assert doc_encoding == windows-1254
assert file_same == 1
key escape
wait-idle
# Editor detection: a fake VS Code install under the scratch %LOCALAPPDATA%; the CreateProcessW
# command line is captured (dry launch) and must split back into exe + --goto file:line:col.
ui fake-editor Programs\Microsoft VS Code\Code.exe
write-file ib-edit.tmp.md "# E\n\nline three\n"
open ib-edit.tmp.md
wait-idle
ui open-editor
wait-idle
assert last_launch contains Microsoft VS Code\Code.exe
assert last_launch contains --goto
assert last_launch contains ib-edit.tmp.md:
assert last_launch_roundtrip == 1
# BUG-02: one-line display math with unbalanced braces is display math in the error style.
write-file ib-math.tmp.md "# M\n\n$$\frac{a}{$$\n\nafter\n"
open ib-math.tmp.md
wait-idle
assert math_display_errors == 1
# CF_HTML offsets match the real byte offsets (non-ASCII content shifts them).
write-file ib-cf.tmp.md "# Çay ve şeker\n\nÜç ğ ı İ ö — “quotes” 😀\n"
open ib-cf.tmp.md
wait-idle
command copy-rich
wait-idle
assert clip_html == 1
assert clip_html_offsets_ok == 1
# BUG-01: Ctrl+click on x.md#frag opens a new window scrolled to the anchor.
